# Pixel 4 (flame) / Pixel 4 XL (coral) -- codename family "floral"
#
# Custom kernel: KernelSU-Next (legacy branch) + SUSFS, built from the EXACT
# AOSP source the stock Android 13 kernel was built from. The device on
# TP1A.221005.002.B2 runs 4.14.276-g6ef255005cea, and
# android-msm-coral-4.14-android13 sits at commit 6ef255005cea -- same tree.

CONFIG_ENV=config/flame.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://android.googlesource.com/kernel/msm
KERNEL_SOURCE_BRANCH=android-msm-coral-4.14-android13
KERNEL_CONFIG=floral_defconfig
# floral boot image carries the appended-DTB, lz4-compressed kernel.
KERNEL_IMAGE_NAME=Image.lz4-dtb
ARCH=arm64
KERNEL_NAME=flame-ksunext-susfs
ADD_LOCALVERSION_TO_FILENAME=false

# Stock build.config uses CC=clang, LD=ld.lld and the GNU assembler (no LLVM IAS).
EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Stock compiler was clang-r416183b; r450784e is the action's verified choice
# for 4.9-4.19 trees.
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false

# ===================================================================== GCC ==
# 4.14 needs a GNU assembler; keep both binutils sets available.
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ===
KSU_VARIANT=kernelsu-next
KSU_REF=legacy
# kprobes is unreliable on 4.14 ("installed but su does nothing"); use manual.
KSU_HOOK_MODE=manual

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

# ================================================================ Kconfig ===
ADD_OVERLAYFS_CONFIG=true
# LTO off for a dependable first build (stock floral_defconfig enables it).
DISABLE_LTO=true
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
