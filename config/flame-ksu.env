# Pixel 4 (flame) / Pixel 4 XL (coral) -- "floral"
#
# Original KernelSU (tiann). On a non-GKI 4.14 tree the action pins it to the
# last non-GKI release (v0.9.5). This is the variant susfs4ksu's kernel-4.14
# branch was written for -- flat KernelSU layout -- so BOTH the kernel-side
# (50_add_susfs) and the KernelSU-side (10_enable_susfs_for_ksu) patches apply.
# Avoids KernelSU-Next's restructured layout (10_enable fails) and SukiSU-Nova's
# static_call.h (a 5.10+ header absent on 4.14).

CONFIG_ENV=config/flame-ksu.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://android.googlesource.com/kernel/msm
KERNEL_SOURCE_BRANCH=android-msm-coral-4.14-android13
KERNEL_CONFIG=floral_defconfig
KERNEL_IMAGE_NAME=Image.lz4-dtb
ARCH=arm64
KERNEL_NAME=flame-ksu-susfs
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Stock Pixel 4 kernel compiler: clang-r416183b (12.0.5). Required so the arm64
# VDSO assembles with the android-4.9 GNU as (newer clang breaks it).
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/rifsxd/android_prebuilts_clang_kernel_linux-x86_clang-r416183b
CUSTOM_CLANG_BRANCH=lineage-20.0
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ===
KSU_VARIANT=kernelsu
# blank -> action auto-pins v0.9.5 for this non-GKI kernel
KSU_REF=
KSU_HOOK_MODE=manual

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14

# ========================================================== Extra patches ===
# KernelSU v0.9.5 calls path_umount(), which 4.14 lacks, so it must be
# backported or vmlinux fails to link (undefined symbol: path_umount). On the
# susfs-patched coral tree the backport's anchor (after do_umount, before the
# umount syscall) sits after may_mount's definition, so it compiles and links
# cleanly. (The earlier misplacement was SukiSU-Ultra's extra namespace.c
# changes, not this tree.)
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

# ================================================================ Kconfig ===
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true
# Don't build the dtbo overlays: coral's sm8150-coral-dvt-overlay.dtbo fails dtc
# (its &spmi_bus include can't be compiled standalone), and a kernel flash keeps
# the stock dtbo partition. This drops the whole ifeq block in the google dts
# Makefile while the base DTBs (appended into Image.lz4-dtb) still build.
EXTRA_DEFCONFIG=CONFIG_BUILD_ARM64_DT_OVERLAY=n

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
