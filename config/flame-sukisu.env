# Pixel 4 (flame) / Pixel 4 XL (coral) -- "floral" -- FALLBACK PROFILE
#
# Same AOSP source as config/flame.env, but using SukiSU-Ultra `builtin`
# instead of KernelSU-Next. Use this if the KernelSU-Next + susfs4ksu run
# fails on the KernelSU-side SUSFS patch: susfs4ksu's kernel-4.14 branch still
# targets KernelSU's old flat layout and will not apply to the restructured
# KernelSU-Next tree. SukiSU-Ultra `builtin` ships SUSFS itself, so that patch
# is skipped and the combination applies cleanly. SukiSU-Ultra is a KernelSU
# variant, so it is still kernel-level `su` + SUSFS hiding, not Magisk.

CONFIG_ENV=config/flame-sukisu.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://android.googlesource.com/kernel/msm
KERNEL_SOURCE_BRANCH=android-msm-coral-4.14-android13
KERNEL_CONFIG=floral_defconfig
KERNEL_IMAGE_NAME=Image.lz4-dtb
ARCH=arm64
KERNEL_NAME=flame-sukisu-susfs
ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Use the STOCK Pixel 4 kernel compiler: clang-r416183b (12.0.5). Its assembly
# output is compatible with the android-4.9 GNU assembler. Newer clang
# (r450784e / clang-14) emits DWARF `.file "..."` directives that binutils 2.27
# rejects ("junk at end of line"), which breaks the arm64 VDSO because 4.14
# builds with -no-integrated-as (GNU as, not clang IAS).
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/rifsxd/android_prebuilts_clang_kernel_linux-x86_clang-r416183b
CUSTOM_CLANG_BRANCH=lineage-20.0
# Ignored while USE_CUSTOM_CLANG=true; kept as a documented fallback.
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_LLVM=false
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

# =============================================================== KernelSU ===
KSU_VARIANT=sukisu-ultra
KSU_REF=builtin
KSU_HOOK_MODE=manual
ENABLE_KPM=false

# =================================================================== SUSFS ==
ENABLE_SUSFS=true
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=kernel-4.14

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=true

# ================================================================ Kconfig ===
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true
EXTRA_DEFCONFIG=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
